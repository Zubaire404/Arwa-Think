# ============================================================
#  ARWA THINK - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and insert your API keys below.

# Google Gemini API (Required for Auto-Routing and Synthesis)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Fireworks AI API (Required for DeepSeek, Qwen, Kimi, etc.)
# Get key from: https://app.fireworks.ai/
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Groq API (Optional)
# Get key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API (Optional)
# Get key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
